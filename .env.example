# Portainer Configuration
# Copy this file to .env and customize as needed

# Log level (DEBUG, INFO, WARN, ERROR)
PORTAINER_LOG_LEVEL=INFO

# Snapshot interval - how often Portainer collects information from endpoints
# Format: duration string (e.g., "5m", "1h", "30s")
PORTAINER_SNAPSHOT_INTERVAL=5m

# Edge agent port
PORTAINER_EDGE_PORT=8000

# Admin password (bcrypt hash)
# Generate with: docker run --rm httpd:2.4-alpine htpasswd -nbB admin "your-password" | cut -d ":" -f 2
# Leave empty to set password via web UI on first login
PORTAINER_ADMIN_PASSWORD=

# SSL Configuration (if using custom certificates)
# Path to SSL certificate file
SSL_CERT_PATH=./certs/portainer.crt

# Path to SSL key file
SSL_KEY_PATH=./certs/portainer.key

# Portainer HTTP port (set to empty to disable HTTP)
PORTAINER_HTTP_PORT=9000

# Portainer HTTPS port
PORTAINER_HTTPS_PORT=9443

# Enable analytics (true/false)
# Set to false to disable anonymous usage statistics
PORTAINER_ANALYTICS=true
